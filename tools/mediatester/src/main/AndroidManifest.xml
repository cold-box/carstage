<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- appCategory and launchable are what the Pleos Music/Audio guide asks of a music app.
         allowAudioPlaybackCapture is the default, written out because CarStage captures this
         app's music to take it out of the microphone (docs/09 "에코 제거"). -->
    <application
        android:allowAudioPlaybackCapture="true"
        android:appCategory="audio"
        android:icon="@android:drawable/ic_media_play"
        android:label="Media Tester">
        <meta-data
            android:name="androidx.car.app.launchable"
            android:value="true" />
        <activity
            android:name=".TesterActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Exported without a permission on purpose: any app (CarStage, the car's media center)
             browses a music app's library the same way. -->
        <service
            android:name=".LibraryService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
    </application>

</manifest>
