<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android's standard vehicle information, protectionLevel="normal": the fuel type (INFO_FUEL_TYPE). -->
    <uses-permission android:name="android.car.permission.CAR_INFO" />
    <!-- Whether it is night (NIGHT_MODE), protectionLevel="normal". -->
    <uses-permission android:name="android.car.permission.CAR_EXTERIOR_ENVIRONMENT" />

    <!-- Pleos Vehicle Service permissions (protectionLevel="normal"). Declare only what the app uses. -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />
    <!-- Pleos TextToSpeech: the MC's voice (audio/Announcer). -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />

    <!-- Android 11+ package visibility: what the app looks up in other apps. -->
    <!-- The Pleos TextToSpeech SDK adds its own query for the car's speech service (docs/05 "Pleos TTS로 MC 음성 확인"). -->
    <queries>
        <!-- The car's music apps (any app with a MediaBrowserService, the Bluetooth app included), for the song list (media/SongShelf). -->
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
    </queries>

    <application
        android:name=".CarStageApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CarStage">
        <!-- Resizing the pane, a density or the car's day and night keep the activity, so the screen
             is not built anew (Pleos app review "Display Compatibility": no state loss when the
             resolution changes; car app quality LS-C1). Compose takes the new configuration itself. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density|uiMode"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Gleo voice actions; must match assets/schema.json and GleoActions.all. -->
            <intent-filter>
                <action android:name="OPEN_STAGE" />
                <action android:name="START_BATTLE" />
                <action android:name="FINISH_SONG" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Notification access the user may grant so the first screen's player can show the playing song (title, artist, position; audio/NowPlaying). The app reads no notifications. -->
        <service
            android:name=".audio.NowPlayingListener"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
